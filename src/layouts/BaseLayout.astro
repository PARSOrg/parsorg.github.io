---
import '../styles/global.css';
import AppsMenu from '../components/AppsMenu.astro';
import Icon from '../components/Icon.astro';
interface Props { title: string; description?: string; theme?: string; }
const { title, description = 'Official PARSOrg website.', theme } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1019" />
    <title>{title}</title>
  </head>
  <body data-theme={theme}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-container header-inner">
        <a class="brand" href="/"><Icon name="layers" size={27} /><span>PARS<span class="brand-accent">Org</span></span></a>
        <nav class="header-actions" aria-label="Main navigation">
          <AppsMenu />
          <a class="github-link" href="https://github.com/PARSOrg" aria-label="PARSOrg on GitHub"><Icon name="github" size={22} /></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="site-container footer-inner"><span>© {new Date().getUTCFullYear()} PARSOrg</span><a href="https://github.com/PARSOrg">GitHub <Icon name="external" size={14} /></a></div>
    </footer>
  </body>
</html>
