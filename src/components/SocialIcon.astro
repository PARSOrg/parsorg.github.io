---
interface Props { name: string }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
{name === 'reddit' && <><circle cx="12" cy="12" r="11"/><g fill="#fff"><ellipse cx="12" cy="14" rx="7" ry="4.8"/><circle cx="5" cy="11" r="2"/><circle cx="19" cy="11" r="2"/><circle cx="18" cy="5.5" r="1.7"/></g><path d="m12 9 1.4-5 4.6 1.5" stroke="#fff" fill="none"/><g fill="currentColor"><circle cx="9" cy="13" r="1.2"/><circle cx="15" cy="13" r="1.2"/></g><path d="M9 16q3 2 6 0" stroke="currentColor" fill="none" stroke-linecap="round"/></>}
{name === 'discord' && <><path d="M19.8 5.2a18 18 0 0 0-4.5-1.4l-.6 1.2a16 16 0 0 0-5.4 0l-.6-1.2a18 18 0 0 0-4.5 1.4C1.3 9.4.5 13.5.9 17.5a18 18 0 0 0 5.5 2.8l1.2-2a12 12 0 0 1-1.8-.9l.4-.3c3.5 1.6 8.1 1.6 11.6 0l.4.3-1.8.9 1.2 2a18 18 0 0 0 5.5-2.8c.5-4.7-.8-8.7-3.3-12.3Z"/><ellipse cx="8.4" cy="12.8" rx="1.7" ry="2" fill="#0b1019"/><ellipse cx="15.6" cy="12.8" rx="1.7" ry="2" fill="#0b1019"/></>}
{name === 'x' && <path d="M18.9 2H22l-6.8 7.8L23.2 22H17l-4.9-7.4L5.6 22H2.4l7.3-8.4L.8 2h6.4l4.5 6.8L18.9 2ZM17.8 20h1.7L6.3 3.9H4.5L17.8 20Z"/>}
{name === 'instagram' && <g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></g>}
</svg>
